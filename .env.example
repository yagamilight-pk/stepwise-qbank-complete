# The complete frontend demo runs without environment variables.
# Add only public browser-safe values with NEXT_PUBLIC_* prefixes.

# Backend/API base URL
NEXT_PUBLIC_API_URL=

# Authentication provider public configuration
NEXT_PUBLIC_AUTH_PROVIDER=
NEXT_PUBLIC_AUTH_CLIENT_ID=

# Billing public key / plan identifiers
NEXT_PUBLIC_BILLING_PUBLISHABLE_KEY=
NEXT_PUBLIC_CORE_PLAN_ID=
NEXT_PUBLIC_PRO_PLAN_ID=

# Product analytics public configuration
NEXT_PUBLIC_ANALYTICS_KEY=
NEXT_PUBLIC_ANALYTICS_HOST=

# Support and product links
NEXT_PUBLIC_SUPPORT_EMAIL=
NEXT_PUBLIC_STATUS_URL=

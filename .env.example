# Local demo mode still runs without environment variables.
# Appwrite values without NEXT_PUBLIC_ are server-only and must never be exposed
# to browser bundles. Vercel should receive these values per environment.

# Public origin for local development. Vercel Production uses
# https://stepwise.page.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Appwrite Cloud project
APPWRITE_ENDPOINT=https://fra.cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=stepwise-qbank-complete
APPWRITE_DATABASE_ID=stepwise
APPWRITE_USER_STATE_TABLE_ID=user_states
# Server-only least-privilege key for normalized data, support, billing, and
# aggregate psychometrics. Never expose this value to browser code.
APPWRITE_API_KEY=

# Public provider label only; no Appwrite credential is exposed to the browser.
NEXT_PUBLIC_AUTH_PROVIDER=appwrite

# One-time Safepay checkout. Keep both flags false until the sandbox webhook,
# replay, cancellation, refund, and reconciliation matrix has passed.
ENABLE_SAFEPAY_CHECKOUT=false
ENABLE_SAFEPAY_WEBHOOK=false
SAFEPAY_ENVIRONMENT=sandbox
SAFEPAY_API_KEY=
SAFEPAY_WEBHOOK_SECRET=
PAYMENT_CURRENCY=USD
STEPWISE_90_PRICE_CENTS=2000
STEPWISE_180_PRICE_CENTS=3000
STEPWISE_360_PRICE_CENTS=5000
ENFORCE_SUBSCRIPTIONS=false

# Public merchant identity. Safepay requires these details to be visible on the
# website and consistent with onboarding documents. Checkout fails closed until
# every field below is configured. Do not use invented or placeholder values.
LEGAL_BUSINESS_NAME=
LEGAL_REGISTRATION_TYPE=
LEGAL_REGISTRATION_NUMBER=
LEGAL_TAX_NUMBER=
LEGAL_REGISTERED_ADDRESS=
LEGAL_OPERATING_ADDRESS=
SUPPORT_PHONE=
LEGAL_EMAIL=legal@stepwise.page
BILLING_EMAIL=billing@stepwise.page

# Appwrite Auth sends verification and password-recovery messages. Configure
# Resend SMTP in Appwrite to send those messages from noreply@stepwise.page.
# The API key below powers welcome, support, and purchase-confirmation emails.
APPWRITE_SMTP_CONFIGURED=false
RESEND_API_KEY=
EMAIL_FROM=Stepwise <noreply@stepwise.page>
EMAIL_REPLY_TO=support@stepwise.page
SUPPORT_INBOX_EMAIL=support@stepwise.page

# Error and performance monitoring. PII and session replay are disabled by
# default in the Sentry configuration committed with this repository.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# Vercel Cron sends this as Authorization: Bearer <secret>.
CRON_SECRET=
SENTRY_ORG=
SENTRY_PROJECT=

# Product analytics public configuration
NEXT_PUBLIC_ANALYTICS_KEY=
NEXT_PUBLIC_ANALYTICS_HOST=

# Support and product links
NEXT_PUBLIC_SUPPORT_EMAIL=support@stepwise.page
NEXT_PUBLIC_STATUS_URL=
